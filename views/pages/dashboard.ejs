<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Tableau de bord</title>
  <link rel="stylesheet" href="/asset/css/general.css">
</head>
<body>
  <%- include('../componements/haeder') %>
  <%- include('../componements/head') %>
  <h2>Tableau de bord</h2>
  <div class="content">
    <section>
      <h3>Statistiques</h3>
      <div class="stats">
        <div class="card">
          <h4>Catways</h4>
          <p><%= totalCatways %></p>
        </div>

        <div class="card">
          <h4>Réservations</h4> 
          <p><%= totalReservations %></p>
        </div>

        <div class="card">
          <h4>En cours</h4>
          <p><%= activeReservations %></p>
        </div>
      </div>
    </section> 
    <section>
    <h3>Prochaines arrivées</h3>

    <table>
      <tr>
        <th>Bateau</th>
        <th>Début</th>
        <th>Fin</th>
      </tr>

      <% upcoming.forEach(r => { %>
        <tr>
          <td><%= r.clientName %></td>
          <td><%= r.boatName %></td>
          <td><%= r.startDate.toLocaleDateString() %></td>
          <td><%= r.endDate.toLocaleDateString() %></td>
        </tr>
      <% }) %>
    </table>
    </section>
  </div>
  <%- include('../componements/footer') %>
</body>
</html>