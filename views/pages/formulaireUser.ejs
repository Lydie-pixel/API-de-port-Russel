<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8">
    <title>Catways</title>
    <link rel="stylesheet" type="text/css" href="/asset/css/general.css">
  </head>
  <body>
  <%- include('../componements/haeder') %>
  <%- include('../componements/head') %>

    <h2><%= user ? "Modifier un utilisateur" : "Ajouter un utilisateur" %></h2>

    <form method="POST" action="<%= user ? '/users/' + user._id : '/users' %>">
      <input type="hidden" name="_debug" value="ok">
      <label>Nom</label>
      <input 
        type="text"
        name="name"
        value="<%= user ? user.name : '' %>"
        required
      >

      <label>Identifiant</label>
      <input 
        type="text"
        name="userName"
        value="<%= user ? user.userName : '' %>"
        required
      >
    
      <% if (!user) { %>
      <label>Mot de passe</label>
      <input 
        type="text"
        name="password"
        value="<%= user ? user.password : '' %>"
        pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{11,}$"
        required
      ><% } %>
      <sub>Le mot de passe doit contenir au moins 12 caractères, une majuscule, une minuscule, un chiffre et un caractère spécial.</sub>

      <label>Email</label>
      <input 
        type="email"
        name="userMail"
        value="<%= user ? user.userMail : '' %>"
        required
      >,

      <label>role</label>
      <select name="role" required>
        <option value="user" <%= user && user.role === "user" ? "selected" : "" %>>User</option>
        <option value="admin" <%= user && user.role === "admin" ? "selected" : "" %>>Admin</option>
      </select>

      <button type="submit">
        <%= user ? "Modifier" : "Ajouter" %>
      </button>
       <button type="button" onclick="window.location.href='/users';">Annuler</button>
    </form>
    <%- include('../componements/footer') %>
  </body>
</html>