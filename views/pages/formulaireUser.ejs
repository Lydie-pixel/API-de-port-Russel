<h1><%= user ? "Modifier un utilisateur" : "Ajouter un utilisateur" %></h1>

<form method="POST" action="<%= user ? '/users/' + user._id : '/users' %>">

  <label>Nom</label>
  <input 
    type="text"
    name="name"
    value="<%= user ? user.name : '' %>"
    required
  >

  <label>Identifiant</label>
  <input 
    type="text"
    name="userName"
    value="<%= user ? user.userName : '' %>"
    required
  >

  <label>Email</label>
  <input 
    type="email"
    name="userMail"
    value="<%= user ? user.userMail : '' %>"
    required
  >

  <button type="submit">
    <%= user ? "Modifier" : "Ajouter" %>
  </button>

</form>