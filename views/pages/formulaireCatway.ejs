<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8">
    <title>Catways</title>
    <link rel="stylesheet" type="text/css" href="/asset/css/general.css">
  </head>
  <body>
    <%- include('../componements/haeder') %>
    <%- include('../componements/head') %>
    <h2><%= catway ? "Modifier un catway" : "Ajouter un catway" %></h2>

    <% if (error) { %>
      <p style="color:red; text-align:center;"><%= error %></p>
    <% } %>
    <form method="POST" action="<%= catway ? '/catways/' + catway._id : '/catways' %>">

      <label>Numéro</label>
      <input 
        type="number"
        name="catwayNumber"
        value="<%= catway ? catway.catwayNumber : '' %>"
        required
        <%= isEdit ? "disabled" : "" %>
      >

      <label>Type</label>
      <select name="catwayType" required <%= isEdit ? "disabled" : "" %>>
        <option value="">-- Choisir --</option>

        <option value="short"
          <%= catway && catway.catwayType === "short" ? "selected" : "" %>>
          Short
        </option>

        <option value="long"
          <%= catway && catway.catwayType === "long" ? "selected" : "" %>>
          Long
        </option>
      </select>

      <label>État</label>
      <input 
        type="text"
        name="catwayState"
        value="<%= catway ? catway.state : '' %>"
        required
      >

      <button type="submit">
        <% if (isEdit) { %>
          Modifier
        <% } else { %>
           Ajouter
        <% } %>
      </button>
       <button type="button" onclick="window.location.href='/catways';">Annuler</button>
    </form>
    <%- include('../componements/footer') %>
  </body>
</html>