<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8">
    <title>Catways</title>
    <link rel="stylesheet" type="text/css" href="/asset/css/general.css">
  </head>
  <body>
    <%- include('../componements/haeder') %>
    <%- include('../componements/head') %>

    <h2><%= reservation ? "Modifier une réservation" : "Ajouter une réservation" %></h2>

    <% if (error) { %>
      <p style="color:red"><%= error %></p>
    <% } %>
    <form method="POST" action="<%= reservation ? '/reservations/' + reservation._id : '/reservations' %>">

      <label>Numéro du Catway</label>
      <input 
        type="number"
        name="catwayNumber"
        value="<%= reservation ? reservation.catwayNumber : '' %>"
        required
      >

      <label>Nom du client</label>
      <input 
        type="text"
        name="clientName"
        value="<%= reservation ? reservation.clientName : '' %>"
        required
      >

      <label>Nom du bateau</label>
      <input 
        type="text"
        name="boatName"
        value="<%= reservation ? reservation.boatName : '' %>"
        required
      >

      <label>Date de début de location</label>
      <input
      type="date"
      name="startDate"
      value="<%= reservation?.startDate?.toISOString?.().split('T')[0] || '' %>"
      required
      >

      <label>Date de fin de location</label>
      <input 
        type="date"
        name="endDate"
        value="<%= reservation?.endDate?.toISOString?.().split('T')[0] || '' %>"
        required
      >

      <button type="submit">
        <% if (isEdit) { %>
          Modifier
        <% } else { %>
          Ajouter
        <% } %>
      </button>
       <button type="button" onclick="window.location.href='/reservations';">Annuler</button>
    </form>
    <%- include('../componements/footer') %>
  </body>
</html>