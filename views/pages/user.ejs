<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Catways</title>
  <link rel="stylesheet" type="text/css" href="/asset/css/general.css">
</head>
<body>

<h1>Liste des Réservations</h1>

<table>
  <thead>
    <tr>
        <th>Nom</th>
        <th>Nom du l'utilisateur</th>
        <th>Mail</th>
        <th>Mot de passe</th>
    </tr>
  </thead>

  <tbody>
    <% catways.forEach(c => { %>
      <tr>
        <td><%= c.name %></td>
        <td><%= c.userName %></td>
        <td><%= c.userMail %></td>
        <td><%= c.userPasseword %></td>
      </tr>
    <% }) %>
  </tbody>
</table>

</body>
</html>